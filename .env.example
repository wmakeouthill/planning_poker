# Planning Poker - Variáveis de Ambiente

# ============================================
# DATABASE (PostgreSQL)
# ============================================
PG_DATABASE=star_wars_app
PG_USER=seu_usuario
PG_PASSWORD=sua_senha

# ============================================
# BACKEND
# ============================================
SPRING_DATASOURCE_URL=jdbc:postgresql://postgresql.uhserver.com:5432/star_wars_app
SPRING_DATASOURCE_USERNAME=seu_usuario
SPRING_DATASOURCE_PASSWORD=sua_senha

# JWT Secret (MUDE EM PRODUÇÃO! Mínimo 32 caracteres)
JWT_SECRET=planning-poker-jwt-secret-key-dev-only-change-in-production-minimum-32-chars
JWT_EXPIRATION=86400000

# Google OAuth2 (opcional - preencher se for usar login com Google)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ============================================
# FRONTEND
# ============================================
NG_APP_API_URL=http://localhost:8080/api
NG_APP_GOOGLE_CLIENT_ID=
