# Planning Poker - Variáveis de Ambiente

# # ============================================
# # DATABASE (MySQL)
# # ============================================
# MYSQL_DATABASE=planningpoker
# MYSQL_USER=planningpoker
# MYSQL_PASSWORD=planningpoker123
# MYSQL_ROOT_PASSWORD=root123

# # ============================================
# # BACKEND
# # ============================================
# SPRING_DATASOURCE_URL=jdbc:mysql://mysql:3306/planningpoker?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=America/Sao_Paulo
# SPRING_DATASOURCE_USERNAME=planningpoker
# SPRING_DATASOURCE_PASSWORD=planningpoker123

# # JWT Secret (MUDE EM PRODUÇÃO! Mínimo 32 caracteres)
# JWT_SECRET=planning-poker-jwt-secret-key-dev-only-change-in-production-minimum-32-chars
# JWT_EXPIRATION=86400000

# # Google OAuth2 (opcional - preencher se for usar login com Google)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# # ============================================
# # FRONTEND
# # ============================================
# NG_APP_API_URL=http://localhost:8080/api
# NG_APP_GOOGLE_CLIENT_ID=
